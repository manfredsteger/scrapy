# MapScraper Pro - Umgebungsvariablen (lokale Installation ohne Docker)
# Kopieren nach .env und Werte anpassen: cp .env.example .env

# Erforderlich: PostgreSQL Verbindungs-URL
# Wenn du stattdessen den Docker-Compose-Postgres-Container nutzt (make dev),
# läuft dieser auf Host-Port 5433 (Container-intern weiterhin 5432):
DATABASE_URL=postgresql://mapscraper:mapscraper_secret@localhost:5433/mapscraper

# Erforderlich: Geheimer Schlüssel für Sessions - für lokale Entwicklung frei
# wählbar, für Produktion unbedingt durch einen eigenen zufälligen Wert ersetzen
SESSION_SECRET=dein-super-geheimer-schluessel-hier

# Server-Port
PORT=5000

# Umgebung (development/production)
NODE_ENV=development

# Optional: aktiviert KI-Funktionen (Keyword-/Entity-Extraktion, Embeddings,
# Metadaten-Anreicherung). Ohne Key laufen diese Schritte einfach übersprungen.
OPENAI_API_KEY=
